rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all images
    allow read: if true;
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'sutharamit344@gmail.com' || 
         request.auth.token.email == 'webiestindiasolution@gmail.com');
    }
    
    // Restrict writes to specific user folders
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Allow read access to shop folder publicly, write only if the user is the shop owner (via Firestore lookup) or admin
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      // Restrict writes: only the shop owner (ownerId matches auth.uid) or an admin may write
      allow write: if isAdmin() ||
                   (
                     request.auth != null &&
                     firestore.get(/databases/(default)/documents/shops/$(shopId)).data.get('ownerId', null) == request.auth.uid
                   );
    }

    // Allow read access to uploads/ folder publicly, write only if signed in
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow read access to blogs/ folder publicly, write only if admin
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
