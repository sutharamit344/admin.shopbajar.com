rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all shop images
    allow read: if true;
    
    // Restrict writes to specific user and shop folders
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /shops/{shopId}/{allPaths=**} {
      allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }
  }
}
