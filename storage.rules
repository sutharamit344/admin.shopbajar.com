rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all images
    allow read: if true;
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'sutharamit344@gmail.com' || 
         request.auth.token.email == 'webiestindiasolution@gmail.com');
    }
    
    // Restrict writes to specific user folders
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Allow write access to shop folder for authenticated users or admins
    match /shops/{shopId}/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Allow authenticated users to upload to uploads/ folder (menu items, photo galleries, etc.)
    match /uploads/{allPaths=**} {
      allow write: if request.auth != null;
    }

    // Allow admins to upload to blogs/ folder
    match /blogs/{allPaths=**} {
      allow write: if isAdmin();
    }
  }
}
