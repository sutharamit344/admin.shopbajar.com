{
  "rules": {
    "qr_tables": {
      "$shopId": {
        ".read": true,
        ".write": "auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null)",
        "$tableId": {
          "currentSessionId": {
            ".write": "auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null)"
          }
        }
      }
    },
    "qr_sessions": {
      "$shopId": {
        ".read": true,
        "$sessionId": {
          ".write": "auth != null && (data.val() == null || data.child('status').val() === 'pending' || data.child('status').val() === 'active') && (newData.val() == null || newData.child('status').val() === 'closed' || newData.child('status').val() === 'rejected' || auth.token.shopId === $shopId || auth.token.shopId == null)",
          "guests": {
            "$guestId": {
              ".write": "auth != null && (root.child('qr_sessions/' + $shopId + '/' + $sessionId + '/status').val() === 'active' || root.child('qr_sessions/' + $shopId + '/' + $sessionId + '/status').val() === 'pending')"
            }
          }
        }
      }
    },
    "qr_orders": {
      "$shopId": {
        "$sessionId": {
          ".read": "root.child('qr_sessions/' + $shopId + '/' + $sessionId).exists()",
          "$orderId": {
            ".write": "auth != null && data.val() == null && root.child('qr_sessions/' + $shopId + '/' + $sessionId + '/status').val() === 'active'"
          }
        }
      }
    },
    "qr_bookings": {
      ".read": "auth != null && (auth.token.email === 'sutharamit344@gmail.com' || auth.token.email === 'webiestindiasolution@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'sutharamit344@gmail.com' || auth.token.email === 'webiestindiasolution@gmail.com')",
      "$shopId": {
        ".read": true,
        "$bookingId": {
          ".read": true,
          ".write": "data.val() == null || (auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null))"
        }
      }
    }
  }
}
