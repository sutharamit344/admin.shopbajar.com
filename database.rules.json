{
  "rules": {
    "qr_tables": {
      "$shopId": {
        ".read": true,
        "$tableId": {
          ".write": "auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null)",
          "currentSessionId": {
            ".write": "data.val() == null || newData.val() == null || (auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null))"
          }
        }
      }
    },
    "qr_sessions": {
      "$shopId": {
        ".read": true,
        "$sessionId": {
          ".write": "data.val() == null || (auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null))",
          "guests": {
            "$guestId": {
              ".write": "root.child('qr_sessions/' + $shopId + '/' + $sessionId + '/status').val() === 'active' || root.child('qr_sessions/' + $shopId + '/' + $sessionId + '/status').val() === 'pending'"
            }
          }
        }
      }
    },
    "qr_orders": {
      "$shopId": {
        ".read": "auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null)",
        "$sessionId": {
          ".read": "root.child('qr_sessions/' + $shopId + '/' + $sessionId).exists()",
          "$orderId": {
            ".write": "(data.val() == null && root.child('qr_sessions/' + $shopId + '/' + $sessionId + '/status').val() === 'active') || (auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null))"
          }
        }
      }
    },
    "qr_bookings": {
      ".read": "auth != null && (auth.token.email === 'sutharamit344@gmail.com' || auth.token.email === 'webiestindiasolution@gmail.com')",
      ".write": "auth != null && (auth.token.email === 'sutharamit344@gmail.com' || auth.token.email === 'webiestindiasolution@gmail.com')",
      "$shopId": {
        ".read": true,
        "$bookingId": {
          ".read": true,
          ".write": "data.val() == null || (auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null)) || (data.child('status').val() === 'pending' && newData.child('status').val() === 'confirmed' && newData.child('paymentStatus').val() === 'paid' && newData.child('paymentTxnId').exists())"
        }
      }
    },
    "appointment_bookings": {
      "$shopId": {
        ".read": true,
        "$bookingId": {
          ".read": true,
          ".write": "data.val() == null || (auth != null && (auth.token.shopId === $shopId || auth.token.shopId == null)) || (data.child('status').val() === 'pending' && newData.child('status').val() === 'confirmed' && newData.child('paymentStatus').val() === 'paid' && newData.child('paymentTxnId').exists())"
        }
      }
    }
  }
}
