rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    // Admin check based on your verified emails
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == 'sutharamit344@gmail.com' || 
         request.auth.token.email == 'webiestindiasolution@gmail.com');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isShopOwner(shopId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.get('ownerId', null) == request.auth.uid;
    }

    function isBillOwner(ownerId) {
      return isSignedIn() && ownerId == request.auth.uid;
    }

    // --- COLLECTION RULES ---
    
    // Admin Verification (Canary Read)
    match /meta/adminCheck {
      allow read: if isAdmin();
    }

    // 1. Shops Management
    match /shops/{shopId} {
      // Public can see all shops for discovery.
      allow read: if true;
      
      // Any signed-in user can create a shop
      allow create: if isSignedIn();
      
      // Only owner or admin can update. Merchants cannot approve their own shop.
      allow update: if isAdmin() || 
                    (isOwner(resource.data.get('ownerId', null)) && 
                     request.resource.data.get('status', null) == resource.data.get('status', null));
      
      // Delete is restricted to Admins
      allow delete: if isAdmin();




      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
        allow delete: if isAdmin();
      }
    }

    // 2. Master Data (Read: All, Write: Admin Only)
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subcategories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /countries/{id} { allow read: if true; allow write: if isAdmin(); }
    match /states/{id} { allow read: if true; allow write: if isAdmin(); }
    match /cities/{id} { allow read: if true; allow write: if isAdmin(); }
    match /areas/{id} { allow read: if true; allow write: if isAdmin(); }
    match /clusters/{id} { allow read: if true; allow write: if isAdmin(); }
    match /locations/{id} {
      allow read: if true; // Public reads for location discovery
      allow write: if isSignedIn(); // Only authenticated users can write (prevents anonymous pollution)
    }

    // 3. Marketing & Content
    match /blogs/{id} { allow read: if true; allow write: if isAdmin(); }

    // 4. Inquiries & Logs
    match /inquiries/{id} {
      allow create: if request.resource.data.shopId != null &&
                    get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('paidFeatures', {}).get('dashboard_checkout', {}).get('enabled', false) == true;
      allow read: if isSignedIn() && (
                    isAdmin() || 
                    get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.get('ownerId', null) == request.auth.uid ||
                    resource.data.get('userId', null) == request.auth.uid
                  );
      allow update: if isAdmin() ||
                    (
                      isShopOwner(resource.data.shopId) &&
                      request.resource.data.keys().hasOnly([
                        'shopId',
                        'shopName',
                        'shopPhone',
                        'deviceId',
                        'items',
                        'totalAmount',
                        'message',
                        'type',
                        'userId',
                        'customerName',
                        'customerPhone',
                        'customerEmail',
                        'status',
                        'createdAt',
                        'updatedAt'
                      ]) &&
                      request.resource.data.shopId == resource.data.shopId &&
                      request.resource.data.shopName == resource.data.shopName &&
                      request.resource.data.shopPhone == resource.data.shopPhone &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.deviceId == resource.data.deviceId &&
                      request.resource.data.message == resource.data.message &&
                      request.resource.data.type == resource.data.type &&
                      request.resource.data.customerName == resource.data.customerName &&
                      request.resource.data.customerPhone == resource.data.customerPhone &&
                      request.resource.data.customerEmail == resource.data.customerEmail &&
                      request.resource.data.createdAt == resource.data.createdAt &&
                      request.resource.data.status in [
                        'Submitted',
                        'Reviewed',
                        'Confirmed',
                        'Completed',
                        'Cancelled'
                      ]
                    );
      allow delete: if isAdmin();
    }
    
    match /activity_logs/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() || request.resource.data.action in ['INQUIRY', 'RATING', 'RATING_SUBMITTED', 'REVIEW_SUBMITTED'];
      allow update, delete: if isAdmin();
    }

    match /bills/{id} {
      allow create: if request.resource.data.shopId != null &&
                    request.resource.data.get('ownerId', null) == get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('ownerId', null) &&
                    (
                      get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('paidFeatures', {}).get('invoice_tools', {}).get('enabled', false) == true ||
                      get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('paidFeatures', {}).get('pos_slip_tools', {}).get('enabled', false) == true ||
                      get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('paidFeatures', {}).get('billing_system', {}).get('enabled', false) == true
                    );
      // Only the shop owner or admin can read bills — invoices contain sensitive PII
      allow read: if isAdmin() ||
                  (
                    isSignedIn() &&
                    resource.data.get('ownerId', null) == request.auth.uid
                  );
      allow update: if request.resource.data.shopId != null &&
                    request.resource.data.get('ownerId', null) == get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.get('ownerId', null) &&
                    request.resource.data.get('shopId', null) == resource.data.get('shopId', null) &&
                    request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null) &&
                    request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if resource.data.shopId != null &&
                    resource.data.get('ownerId', null) == get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.get('ownerId', null);
    }

    // 5. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // 6. SaaS Features Master (Read: All, Write: Admin Only)
    match /features/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. SaaS Payments Transactions (Read/Create: Owner/Admin, Write: Admin Only)
    match /payments/{id} {
      allow create: if isSignedIn() && 
                    request.resource.data.shopId != null &&
                    get(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerId == request.auth.uid;
      allow read: if isSignedIn() && (
                    isAdmin() || 
                    (resource.data.shopId != null &&
                     get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId == request.auth.uid)
                  );
      allow update, delete: if isAdmin();
    }

    // 8. Booking Payments & Settlements
    match /booking_payments/{id} {
      allow create: if true;
      allow read: if isAdmin() || isShopOwner(resource.data.shopId);
      allow update, delete: if isAdmin();
    }
  }
}

